# ============================================
# DIGITO ADMIN DASHBOARD - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the actual values
# DO NOT commit .env.local to git (it's in .gitignore)

# ============================================
# GOOGLE GEMINI AI (SERVER-SIDE ONLY)
# ============================================
# Used for AI writing assistant features (improve, shorten, expand, fix grammar)
# Get API key from: https://aistudio.google.com/apikey
# OPTIONAL: AI features gracefully degrade if not configured

# Google Gemini API key (required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.5-flash-lite)
# Options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-1.5-pro
# The 'lite' version is faster and cheaper, suitable for text improvements
GEMINI_MODEL=gemini-2.5-flash-lite

# ============================================
# AWS COGNITO (SERVER-SIDE)
# ============================================
# Used for server-side JWT verification and admin operations
# Get these from AWS Console → Cognito → User Pools

# Cognito User Pool ID (e.g., eu-central-1_xxxxxxxxx)
COGNITO_USER_POOL_ID=your_user_pool_id_here

# Cognito App Client ID
COGNITO_USER_POOL_CLIENT_ID=your_client_id_here

# AWS region (default: eu-central-1)
COGNITO_REGION=eu-central-1

# AWS credentials for Cognito admin operations (optional if using IAM roles)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================
# WEBHOOK SECURITY
# ============================================
# Shared secret for Lambda → API webhook authentication
WEBHOOK_SECRET=your_webhook_secret_here

# Lambda trigger webhook endpoints (set per environment)
# POST_CONFIRMATION_API_URL=https://your-domain.com/api/webhooks/auth/user-created
# PRE_SIGNUP_API_URL=https://your-domain.com/api/webhooks/auth/verify-user

# ============================================
# MONGODB
# ============================================
# Connection string for MongoDB Atlas (goodgest-admin database)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# Master database name for admin users, clients, and client-event mappings
# Default: goodgest-admin
MONGODB_ADMIN_DB_NAME=goodgest-admin

# ============================================
# CLOUDFLARE R2 (FILE STORAGE)
# ============================================
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
CLOUDFLARE_R2_ENDPOINT=https://xxxxx.eu.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
